<div class="feature col-6 col-md-3 col-lg-3 text-center d-flex flex-column">
    <p class="mb-2">{{ title }}</p>
    {{ if title == "MongoDB" }}
    <img src="{{ img }}" alt="{{ desc }}" class="img-fluid m-auto" style="max-width: 50px;">
    {{ else }}
    <img src="{{ img }}" alt="{{ desc }}" class="img-fluid m-auto" style="max-width: 100px;">
    {{ /if }}
</div>